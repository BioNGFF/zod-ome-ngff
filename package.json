{
  "name": "zod-ome-ngff",
  "description": "zod schemas for OME-NGFF",
  "version": "0.3.0",
  "type": "module",
  "author": "Trevor Manz",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "check": "tsc && publint",
    "build": "tsc && publint",
    "prepare": "tsc && publint",
    "fmt": "deno fmt src test"
  },
  "exports": {
    "./0.1": {
      "types": "./dist/0.1.d.ts",
      "import": "./dist/0.1.js"
    },
    "./0.2": {
      "types": "./dist/0.2.d.ts",
      "import": "./dist/0.2.js"
    },
    "./0.3": {
      "types": "./dist/0.3.d.ts",
      "import": "./dist/0.3.js"
    },
    "./0.4": {
      "types": "./dist/0.4.d.ts",
      "import": "./dist/0.4.js"
    },
    "./0.5": {
      "types": "./dist/0.5.d.ts",
      "import": "./dist/0.5.js"
    },
    "./latest": {
      "types": "./dist/latest.d.ts",
      "import": "./dist/latest.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^10.1.0",
    "@changesets/cli": "^2.31.1",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "^18.19.130",
    "@vitest/coverage-c8": "^0.29.8",
    "camelcase": "^7.0.1",
    "glob": "^9.3.5",
    "json-schema-to-zod": "^0.6.3",
    "publint": "^0.1.16",
    "typescript": "^4.9.5",
    "vitest": "^0.29.8",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "pnpm": "^9.0.0"
  }
}
